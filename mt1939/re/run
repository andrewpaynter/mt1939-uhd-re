#!/bin/bash
# Run a python snippet/script in the analysis container with the project mounted at /work.
# Portable: resolves the project dir (mt1939/) relative to this script.
# Image-selection env vars are passed through: FWIMG (fw.py), FWA/FWB (xmatch.py).
PROJ="$(cd "$(dirname "$0")/.." && pwd)"
ENVS=()
for v in FWIMG FWA FWB; do [ -n "${!v}" ] && ENVS+=(-e "$v=${!v}"); done
exec docker run --rm -i -v "$PROJ:/work" -w /work -e PYTHONPATH=/work/re "${ENVS[@]}" mt1939-re python "$@"
